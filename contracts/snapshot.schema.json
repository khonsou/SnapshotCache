{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuyan.local/contracts/snapshot-v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        }
      },
      "required": [
        "tenantId",
        "projectId"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "parentSnapshotId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "query": {
      "type": "object",
      "properties": {
        "resourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "resourceId",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "entryResourceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "resourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                },
                "minItems": 1,
                "maxItems": 512,
                "uniqueItems": true
              },
              "schemaResourceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              }
            },
            "required": [
              "id",
              "entryResourceId",
              "resourceIds"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 512
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "datasets",
        "contentHash"
      ],
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "properties": {
        "runtime": {
          "const": "web"
        },
        "runtimeVersion": {
          "const": "1"
        },
        "entryResourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "resourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true
        },
        "bindings": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "initialStateResourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "runtime",
        "runtimeVersion",
        "entryResourceId",
        "resourceIds",
        "bindings",
        "contentHash"
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "mediaType": {
            "type": "string",
            "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "mediaType",
          "byteLength",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 512
    },
    "totalResourceBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "integrity": {
      "type": "object",
      "properties": {
        "manifestHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "manifestHash"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schemaVersion",
    "snapshotId",
    "scope",
    "createdAt",
    "query",
    "data",
    "presentation",
    "resources",
    "totalResourceBytes",
    "integrity"
  ],
  "additionalProperties": false,
  "$defs": {
    "QueryContext": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "object",
          "properties": {
            "intent": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "name",
                "version"
              ],
              "additionalProperties": false
            },
            "parameters": {
              "type": "object"
            },
            "contextHash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "authorization": {
              "type": "object",
              "properties": {
                "scopeHash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "policyVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "scopeHash",
                "policyVersion"
              ],
              "additionalProperties": false
            },
            "locale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sourceSelections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  "revision": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 512
                  }
                },
                "required": [
                  "sourceId",
                  "revision"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 512
            },
            "presentationRequest": {
              "type": "object"
            }
          },
          "required": [
            "intent",
            "parameters",
            "contextHash",
            "authorization",
            "locale",
            "timezone",
            "sourceSelections",
            "presentationRequest"
          ],
          "additionalProperties": false
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "revision": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "observedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "sourceId",
              "revision",
              "observedAt"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 512
        },
        "originalText": {
          "type": "string",
          "maxLength": 10000
        }
      },
      "required": [
        "identity",
        "observations"
      ],
      "additionalProperties": false
    },
    "MessageSnapshotRef": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "manifestHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "snapshotId",
        "manifestHash"
      ],
      "additionalProperties": false
    }
  }
}
