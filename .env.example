DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional production overrides:
# CLAUDE_CODE_BIN=/absolute/path/to/claude
# AGENT_EFFORT=medium
# Optional emergency ceiling. Leave unset for third-party providers whose cost accounting may not match Claude pricing.
# AGENT_MAX_BUDGET_USD=2.00
PORT=4173
# Browser-visible origin. Set the HTTPS origin explicitly when Node runs behind a reverse proxy.
APP_PUBLIC_ORIGIN=http://127.0.0.1:4173

# DAO OAuth Phase 0. Current DAO contract does not require a client_id parameter.
# Set only if DAO assigns this app an explicit client later.
DAO_OAUTH_CLIENT_ID=
# Optional for a confidential BFF client. Keep this server-side only.
DAO_OAUTH_CLIENT_SECRET=
# DAO OAuth service origin.
VITE_AUTH_ORIGIN=https://auth.angrymiao.com
DAO_OAUTH_AUTHORIZATION_URL=https://auth.angrymiao.com/oauth/authorize
DAO_OAUTH_TOKEN_URL=https://auth.angrymiao.com/api/oauth/token
# Optional: when omitted, the BFF uses user_id/user_name from the JWT returned by DAO.
DAO_OAUTH_PROFILE_URL=
# Production must use the exact HTTPS callback registered in DAO.
DAO_OAUTH_REDIRECT_URI=
DAO_OAUTH_SCOPES=profile phone
# Optional dot path when the profile id is not one of id/user_id/userId/sub/uid.
DAO_OAUTH_USER_ID_PATH=
DAO_SESSION_IDLE_SECONDS=1800
DAO_SESSION_ABSOLUTE_SECONDS=28800
# Development only; ignored in production.
XUYAN_AUTH_ALLOW_HTTP=false
# Automated/local UI tests only. Leave false or unset for manual OAuth testing and production.
XUYAN_AUTH_BYPASS=false
