{
  "name": "xuyan-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && node --env-file-if-exists=.env server/local.mjs",
    "contracts:build": "node scripts/compile-contracts.mjs",
    "fixtures:generate": "npm run contracts:build && node scripts/generate-fixtures.mjs",
    "fixtures:verify": "npm run contracts:build && node scripts/verify-fixtures.mjs",
    "build": "npm run contracts:build && node scripts/build.mjs",
    "test": "npm run contracts:build && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run fixtures:verify",
    "backup": "node scripts/backup.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2"
  }
}
